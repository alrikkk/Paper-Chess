# Frontend Environment Variable (configured in the Frontend Vercel Project):
# Base URL for the Paper Chess FastAPI backend
# Local development default: http://127.0.0.1:8000
# Production on Vercel: set to your deployed backend URL (e.g. https://paper-chess-backend.vercel.app)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend Environment Variable (configured in the Backend Vercel Project):
# Comma-separated list of allowed frontend origins (in addition to localhost:5173 / localhost:4173)
# Example: https://paper-chess.vercel.app,https://paper-chess-git-main-alrikkk.vercel.app
ALLOWED_ORIGINS=https://paper-chess.vercel.app
